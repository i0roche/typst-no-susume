<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>susume-muted</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#222222</string>
        <key>background</key><string>#FAFAFA</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>コメント</string>
      <key>scope</key><string>comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#7a828e</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>文字列</string>
      <key>scope</key><string>string, markup.raw</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#8a5a2b</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>数値・定数</string>
      <key>scope</key><string>constant, constant.numeric, constant.language, constant.character.escape</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#8a4f7d</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>キーワード</string>
      <key>scope</key><string>keyword, storage, keyword.control, keyword.operator.word</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#3b5b92</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>関数</string>
      <key>scope</key><string>entity.name.function, support.function, entity.name.function.call</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#2e7d6b</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>型・タグ</string>
      <key>scope</key><string>entity.name.type, entity.name.tag, support.type, support.class</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#2e7d6b</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>ラベル・参照</string>
      <key>scope</key><string>entity.name.label, markup.underline.link, string.other.link, meta.link</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#3b5b92</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>見出し・強調</string>
      <key>scope</key><string>markup.heading, markup.bold</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#222222</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>斜体</string>
      <key>scope</key><string>markup.italic</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#222222</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>演算子</string>
      <key>scope</key><string>keyword.operator, punctuation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#555555</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
